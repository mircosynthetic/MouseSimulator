package com.example.mousesimulator;

import android.app.Service;
import android.content.Intent;
import android.graphics.PixelFormat;
import android.os.IBinder;
import android.view.*;
import android.widget.Button;

public class MouseOverlayService extends Service {
    private WindowManager wm;
    private View overlay;
    private WindowManager.LayoutParams params;
    private float cursorX = 540f, cursorY = 960f;

    @Override
    public IBinder onBind(Intent i) { return null; }

    @Override
    public void onCreate() {
        super.onCreate();
        wm = (WindowManager) getSystemService(WINDOW_SERVICE);
        overlay = LayoutInflater.from(this).inflate(R.layout.overlay_layout, null);
        params = new WindowManager.LayoutParams(
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.WRAP_CONTENT,
            WindowManager.LayoutParams.TYPE_APPLICATION_OVERLAY,
            WindowManager.LayoutParams.FLAG_NOT_FOCUSABLE,
            PixelFormat.TRANSLUCENT);
        params.gravity = Gravity.TOP | Gravity.START;
        params.x = 50; params.y = 200;
        wm.addView(overlay, params);

        // Drag
        overlay.findViewById(R.id.tvDragBar).setOnTouchListener((v, e) -> {
            if (e.getAction() == MotionEvent.ACTION_DOWN) {
                v.setTag(new float[]{params.x - e.getRawX(), params.y - e.getRawY()});
                return true;
            }
            if (e.getAction() == MotionEvent.ACTION_MOVE) {
                float[] d = (float[]) v.getTag();
                params.x = (int)(e.getRawX() + d[0]);
                params.y = (int)(e.getRawY() + d[1]);
                wm.updateViewLayout(overlay, params);
                return true;
            }
            return false;
        });

        // Trackpad
        overlay.findViewById(R.id.trackpad).setOnTouchListener((v, e) -> {
            if (e.getAction() == MotionEvent.ACTION_DOWN) { v.setTag(new float[]{e.getRawX(), e.getRawY()}); return true; }
            if (e.getAction() == MotionEvent.ACTION_MOVE) {
                float[] l = (float[]) v.getTag();
                cursorX += (e.getRawX() - l[0]) * 3f;
                cursorY += (e.getRawY() - l[1]) * 3f;
                cursorX = Math.max(0, Math.min(cursorX, getResources().getDisplayMetrics().widthPixels));
                cursorY = Math.max(0, Math.min(cursorY, getResources().getDisplayMetrics().heightPixels));
                v.setTag(new float[]{e.getRawX(), e.getRawY()});
                return true;
            }
            return false;
        });

        // Buttons
        MouseAccessibilityService svc = MouseAccessibilityService.getInstance();
        overlay.findViewById(R.id.btnLeftClick).setOnClickListener(v -> { if (svc != null) svc.performClick(cursorX, cursorY); });
        overlay.findViewById(R.id.btnDoubleClick).setOnClickListener(v -> { if (svc != null) svc.performDoubleClick(cursorX, cursorY); });
        overlay.findViewById(R.id.btnLongClick).setOnClickListener(v -> { if (svc != null) svc.performLongClick(cursorX, cursorY); });
    }

    @Override
    public void onDestroy() {
        super.onDestroy();
        if (overlay != null) wm.removeView(overlay);
    }
}
